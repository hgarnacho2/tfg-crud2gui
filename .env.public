# ---------------------------------------
# Fichero de entorno publico. se versiona
# ---------------------------------------

# Activación del filtrado de enunciados (true/false)
FILTER_STATEMENT_TEXT=true

# Ruta al JSON de reglas del filtro, relativa a la raíz del proyecto
STATEMENT_FILTER_CONFIG_PATH=modules/statement-text-extractor/config/statement-filter.json

# Modelos predeterminados del módulo statement-analyzer
STATEMENT_ANALYZER_GEMINI_MODEL=gemini-3.5-flash-lite
STATEMENT_ANALYZER_OLLAMA_MODEL=qwen3:8b
# Para Groq, define STATEMENT_ANALYZER_GROQ_MODEL con el modelo deseado.

# Microsoft Entra ID para CRUD2GUI (cliente público de escritorio, sin client secret)
AZURE_CLIENT_ID=cb1ed692-ecef-4a08-b47a-c5292b8b7f86
AZURE_TENANT_ID=81fbt1.onmicrosoft.com

# Modo debug (true/false)
DOTENV_DEBUG=false