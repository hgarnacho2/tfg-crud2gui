# ---------------------------------------
# Fichero de entorno publico. se versiona
# ---------------------------------------

# Activación del filtrado de enunciados (true/false)
FILTER_STATEMENT_TEXT=true

# Ruta al JSON de reglas del filtro, relativa a la raíz del proyecto
STATEMENT_FILTER_CONFIG_PATH=modules/statement-text-extractor/config/statement-filter-rules.json

# Carpeta del texto extraido; vacia guarda junto al PDF
STATEMENT_TEXT_OUTPUT_DIR=data/2-statement_text
# Carpeta del texto filtrado; vacia guarda junto al texto extraido
STATEMENT_FILTERED_OUTPUT_DIR=data/3-statement_text_filtered
# Carpeta del modelo extraido del codigo; relativa a la raiz del proyecto o absoluta
JAVA_MODEL_OUTPUT_DIR=data/8-java_code_model
# Carpetas de salida del modelo inferido y del informe de validacion
STATEMENT_MODEL_OUTPUT_DIR=data/5-statement_infered_model
# Carpeta de salida del informe de validación
VALIDATION_REPORT_OUTPUT_DIR=data/9-model_validation
# Carpeta de salida del modelo revisado (Si se deja vacía se guardará junto al modelo original)
STATEMENT_REVIEW_OUTPUT_DIR=data/6-statement_infered_model_verified

# Modelos predeterminados del módulo statement-analyzer
STATEMENT_ANALYZER_GEMINI_MODEL=gemini-3.5-flash-lite
STATEMENT_ANALYZER_OLLAMA_MODEL=qwen3:8b
STATEMENT_ANALYZER_GROQ_MODEL=openai/gpt-oss-120b

# Navegador para el inicio y cierre de sesión: webview(embebido) o system(Navegador web del sistema)
AZURE_AUTH_BROWSER=webview

# Modo debug (true/false)
DOTENV_DEBUG=false